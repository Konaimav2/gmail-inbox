# ============ core ============
PORT=8790
HOST=127.0.0.1
# password for the web UI login + X-API-Key for /api/*
PASSWORD=
API_KEY=
SESSION_SECRET=
# read-only public token for share links (optional)
PUBLIC_TOKEN=
TRUST_PROXY=0

# ============ captcha vision (OpenAI-compatible) ============
ROUTER9_BASE=https://api.openai.com/v1
ROUTER9_API_KEY=
# fallback kalau ROUTER9_API_KEY kosong
OPENAI_API_KEY=
CAPTCHA_VISION_MODEL=deepseek-v4.1-flash
AUDIO_SOLVER_PY=scripts/audio-solver.py

# ============ session keeper (runs inside server.mjs) ============
WARM_MINUTES=20
KEEPALIVE_HOURS=12
DEVICE_STALE_DAYS=7
VERIFY_WAIT_MS=30000
# force refresh kalau cookie lebih tua dari ini (ms)
REFRESH_STALE_MS=21600000

# ============ batch login ============
RUN_LOG=logs
BATCH_MIN_RAM_MB=900
BATCH_FRESH_MINUTES=45
BROWSER_RESTART_EVERY=15
CHROME_BIN=
CHROME_ARGS=
XVFB_ONLY=0
USE_SECURITY_CODE=1
# optional: pass password/token from the queue without reading list.txt
RUNBATCH_PW=
RUNBATCH_TOK=
# proxy default untuk batch (http://user:pass@host:port)
RUNBATCH_PROXY=

# ============ VNC (batch only) ============
VNC_PASSWORD=
VNC_BIND=127.0.0.1
VNC_PORT=6080
# host shown in the "open VNC" hint (public IP/domain)
VNC_PUBLIC_HOST=127.0.0.1

# ============ spam filter (optional) ============
SPAM_ENABLED=0
SPAM_PYTHON=python3
SPAM_SYNC=
SPAM_SYNC_MINUTES=15
SPAM_DISPLAY=0

# ============ monitor / public edge ============
MONITOR_SECONDS=60
SYNC_MINUTES=10
# watchdog curls this; leave empty to skip the public-edge check
EDGE_URL=

# ============ tools ============
# base URL untuk scripts/api-smoke.mjs
BASE=http://127.0.0.1:8790
