# copy to .env and fill real values
PORT=8790
HOST=127.0.0.1
PASSWORD=CHANGE_ME
# VNC password used by scripts/run-batch.mjs (x11vnc). AUTO-GENERATED randomly on first
# batch run if unset — never leave a real value in this example.
# VNC_PASSWORD=CHANGE_ME
# VNC bind address (run-batch VNC viewer). Default: 127.0.0.1. Set to 0.0.0.0 for external access.
# VNC_BIND=0.0.0.0
# API key + public token are AUTO-GENERATED and persisted in the local SQLite DB (inbox.db).
# To override, set them here; otherwise leave unset and they persist across restarts.
# API_KEY=mh_live_...
# PUBLIC_TOKEN=...
# SESSION_SECRET=... (auto-generated + stored in DB if unset)
# monitor (atom feed / new-mail push) interval in seconds
MONITOR_SECONDS=120
# full 30d history sync interval (marks sessions active) in minutes
SYNC_MINUTES=300
